# Atlas OS window theme for Openbox 3.6 (DESIGN §24.10). Installed to /usr/share/themes/AtlasOS by install-atlas-os.sh.
# Title font and size are set in rc.xml (<theme><font>); buttons grow with the title height.
border.width: 1
padding.width: 6
padding.height: 5
window.handle.width: 6
window.client.padding.width: 0
window.client.padding.height: 0
window.label.text.justify: center

window.active.border.color: #3a4790
window.inactive.border.color: #262f5e
window.active.title.separator.color: #1c2454
window.inactive.title.separator.color: #151b3d
window.active.client.color: #1c2454
window.inactive.client.color: #151b3d

window.active.title.bg: flat solid
window.active.title.bg.color: #1c2454
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #151b3d
window.active.label.bg: parentrelative
window.active.label.text.color: #eef2fa
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #8f9abb

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1c2454
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #151b3d
window.active.grip.bg: flat solid
window.active.grip.bg.color: #4b5bb0
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #2c366b

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #dfe6f2
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #34428a
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #5266c8
window.active.button.pressed.image.color: #ffffff
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #59627f
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #dfe6f2
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #34428a
window.active.button.toggled.hover.image.color: #ffffff
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #5266c8
window.active.button.toggled.pressed.image.color: #ffffff

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #8f9abb
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #2a3570
window.inactive.button.hover.image.color: #eef2fa
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #5266c8
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #454d69
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #8f9abb
window.inactive.button.toggled.hover.bg: flat solid
window.inactive.button.toggled.hover.bg.color: #2a3570
window.inactive.button.toggled.hover.image.color: #eef2fa
window.inactive.button.toggled.pressed.bg: flat solid
window.inactive.button.toggled.pressed.bg.color: #5266c8
window.inactive.button.toggled.pressed.image.color: #ffffff

menu.border.width: 1
menu.border.color: #3a4790
menu.separator.color: #2c366b
menu.title.bg: flat solid
menu.title.bg.color: #1c2454
menu.title.text.color: #eef2fa
menu.items.bg: flat solid
menu.items.bg.color: #151b3d
menu.items.text.color: #dfe6f2
menu.items.disabled.text.color: #59627f
menu.items.active.bg: flat solid
menu.items.active.bg.color: #34428a
menu.items.active.text.color: #ffffff
menu.items.active.disabled.text.color: #8f9abb

# Alt+Tab window switcher
osd.border.width: 1
osd.border.color: #3a4790
osd.bg: flat solid
osd.bg.color: #151b3d
osd.label.text.color: #eef2fa
osd.hilight.bg: flat solid
osd.hilight.bg.color: #5266c8
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2c366b
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #1c2454
osd.button.unpressed.box.color: #3a4790
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: #34428a
osd.button.focused.box.color: #5266c8
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #5266c8
osd.button.pressed.box.color: #5266c8
