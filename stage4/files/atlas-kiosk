#!/bin/bash
# Keeps the Atlas desktop on the display (Atlas OS DESIGN §19.3, §22.3). Started by Openbox's autostart.
# - Atlas running -> one Chrome (Atlas's own profile, NOT --kiosk: that would make every window full screen) with
#     * the desktop  http://localhost:4950/desktop   (WM_CLASS "localhost__desktop": Openbox keeps it below, undecorated;
#                                                     this script sizes it to the whole screen)
#     * the Atlas window  http://127.0.0.1:4950/?window=1  (Atlas floats it on the right via wmctrl)
# - Atlas failed  -> Chrome kiosk (full screen) on the recovery page http://127.0.0.1:4951/
# - A window closed (Alt+F4), Chrome crashed, or Atlas changed state -> opened again.
DESKTOP="http://localhost:4950/desktop"
ATLAS_WINDOW="http://127.0.0.1:4950/?window=1"
PEMULIHAN="http://127.0.0.1:4951/"
PROFILE="$HOME/.local/share/atlas/chrome-atlas"
FLAGS=(--user-data-dir="$PROFILE" --autoplay-policy=no-user-gesture-required
  --no-first-run --no-default-browser-check --disable-features=Translate --noerrdialogs --password-store=basic
  --disable-session-crashed-bubble --check-for-update-interval=31536000)

keadaan() {
  if systemctl --user is-failed --quiet atlas.service; then echo pemulihan
  elif curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:4950/"; then echo atlas
  fi
}

# Window ids by WM_CLASS / title (wmctrl -lx: id desktop class host title).
win_desktop() { wmctrl -lx 2>/dev/null | awk '$3 ~ /^localhost__desktop\./ {print $1; exit}'; }
# Atlas window = WM_CLASS instance exactly "127.0.0.1" (/?window=1), not its title: the title only appears once the
# page has loaded, and a slow boot would open a second window (DESIGN §23 no. 7).
win_atlas() { wmctrl -lx 2>/dev/null | awk '$3 ~ /^127\.0\.0\.1\.[^.]+$/ {print $1; exit}'; }

# DESIGN §23 B: Atlas's Chrome profile only shows Atlas's own windows. A normal browser window (Ctrl+N / Ctrl+T)
# or DevTools in this profile is closed. A speed bump, not a sandbox (the dock Browser uses another profile).
tutup_asing() {
  local pid
  pid=$(pgrep -o -f -- "--user-data-dir=$PROFILE") || return 0
  wmctrl -lpx 2>/dev/null | awk -v p="$pid" '$3 == p && $4 !~ /^(localhost__desktop|127\.0\.0\.1|127\.0\.0\.1__settings)\.[^.]+$/ {print $1}' |
    while read -r w; do wmctrl -i -c "$w"; done
}

bersihkan_profil() {
  # A killed Chrome marks its last exit as a crash and shows a "restore pages?" bar: mark it as a normal exit.
  [ -f "$PROFILE/Default/Preferences" ] && sed -i 's/"exit_type":"[A-Za-z]*"/"exit_type":"Normal"/; s/"exited_cleanly":false/"exited_cleanly":true/' "$PROFILE/Default/Preferences"
}

# Only by profile: $CHROME may be an old PID that the system has since given to another program (DESIGN §23 no. 5).
henti_chrome() { pkill -f -- "--user-data-dir=$PROFILE" 2>/dev/null; sleep 1; }

mkdir -p "$PROFILE/Default"
while true; do
  K=$(keadaan)
  if [ -z "$K" ]; then sleep 2; continue; fi
  bersihkan_profil
  if [ "$K" = pemulihan ]; then
    pkill -f -- "--user-data-dir=$PROFILE" 2>/dev/null; sleep 1
    google-chrome "${FLAGS[@]}" --kiosk --app="$PEMULIHAN" >/dev/null 2>&1 &
    CHROME=$!
    while kill -0 "$CHROME" 2>/dev/null; do
      sleep 5
      [ "$(keadaan)" = atlas ] && { henti_chrome; break; }
    done
  else
    # The first Chrome becomes the browser process; later `google-chrome --app=…` calls hand the URL to it and exit.
    # Every launch runs in the background: a call made while Chrome is still starting may itself become the
    # browser (VM test 2026-11-24: a foreground call then blocked this loop). The loop follows whichever
    # Chrome of this profile is alive, so Atlas opening the Settings window first is fine too.
    alive() { pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null; }
    if ! alive; then google-chrome "${FLAGS[@]}" --app="$DESKTOP" >/dev/null 2>&1 & fi
    DIATUR=""            # desktop window id already sized to the screen
    ATLAS_DIBUKA=0       # when the Atlas window was last opened
    DESKTOP_DIBUKA=$SECONDS
    sleep 3
    while alive; do
      sleep 2
      [ "$(keadaan)" = pemulihan ] && { henti_chrome; break; }
      tutup_asing
      D=$(win_desktop)
      if [ -n "$D" ] && [ "$D" != "$DIATUR" ]; then
        read -r W H < <(xdotool getdisplaygeometry)
        wmctrl -i -r "$D" -b remove,maximized_vert,maximized_horz
        wmctrl -i -r "$D" -e "0,0,0,$W,$H" && wmctrl -i -r "$D" -b add,below,sticky,skip_taskbar,skip_pager && DIATUR="$D"
      elif [ -n "$D" ]; then
        # Second guard (review §24.10 no. 1): a desktop that got iconified or maximized anyway comes back within 2 s.
        case "$(xprop -id "$D" _NET_WM_STATE 2>/dev/null)" in
          *_NET_WM_STATE_HIDDEN*) wmctrl -i -a "$D"; DIATUR="" ;;
          *_NET_WM_STATE_MAXIMIZED*) DIATUR="" ;;
        esac
      fi
      if [ -z "$D" ] && [ $((SECONDS - DESKTOP_DIBUKA)) -gt 15 ]; then
        google-chrome "${FLAGS[@]}" --app="$DESKTOP" >/dev/null 2>&1 & DESKTOP_DIBUKA=$SECONDS
      fi
      # The Atlas window only once the desktop exists (Chrome is up), so both share one browser process.
      if [ -n "$D" ] && [ -z "$(win_atlas)" ] && [ $((SECONDS - ATLAS_DIBUKA)) -gt 20 ]; then
        google-chrome "${FLAGS[@]}" --app="$ATLAS_WINDOW" >/dev/null 2>&1 & ATLAS_DIBUKA=$SECONDS
      fi
    done
  fi
  wait 2>/dev/null
  sleep 2
done
